{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app3",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "08aee657-5aec-4c24-b6e5-48b657433c19","database_name": "web-app3" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "251bcc6089b64ae7959ddcde022c28f9" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
